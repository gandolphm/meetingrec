# macOS
.DS_Store

# Per-machine Claude Code permissions (contain absolute home-folder paths)
**/.claude/settings.local.json

# Obsidian per-user workspace and plugin state
.obsidian/
.trash/

# Python
__pycache__/

# Recordings, transcripts and generated notes are personal — never commit them.
# The folders themselves are kept via .gitkeep.
scribe/input/*
scribe/transcripts/*
scribe/meeting-notes/*
teamnotes/input/*
teamnotes/meeting-notes/*
teamnotes/share/*
!**/.gitkeep

# Each user's own settings (names and rules) and team profiles: everything in the
# settings folders except the tracked templates (*.example.md), shared.md and the
# `other` profile. The skills and the installer create the user's copies from the
# templates, so updates never collide with them.
scribe/settings/*
!scribe/settings/*.example.md
!scribe/settings/shared.md
teamnotes/settings/*
!teamnotes/settings/*.example.md
!teamnotes/settings/shared.md
!teamnotes/settings/profiles/
teamnotes/settings/profiles/*
!teamnotes/settings/profiles/*.example.md
!teamnotes/settings/profiles/other.md
