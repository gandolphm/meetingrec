#!/usr/bin/env bash
#
# teamnotes — write up team notes from any folder: opens the coding agent in
# teamnotes/, where the team-notes skill lives, and starts it.
#
#   teamnotes                       start the write-up
#   teamnotes keep the transcript   anything after it goes along as extra instructions
#
# The agent is Claude Code unless NOTES_AGENT says otherwise (see
# lib/start-agent.sh). With Claude Code it's the same as:
# cd <repo>/teamnotes && claude, then typing: team notes
set -euo pipefail

# Follow the ~/.local/bin link back to the repo, wherever it was cloned.
REPO_ROOT="$(dirname "$(dirname "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")")")"
exec bash "$REPO_ROOT/.engine/lib/start-agent.sh" teamnotes "team notes" "$@"
